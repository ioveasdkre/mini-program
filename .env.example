NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# 本機為 http://localhost:3000/auth/google，正式環境為 https://<網域>/auth/google
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google

# 至少 32 字元（例如 openssl rand -base64 32）
NUXT_SESSION_PASSWORD=

# 允許登入的 Email，以逗號分隔
ALLOWED_EMAILS=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
