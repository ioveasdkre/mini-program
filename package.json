{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint -c ./eslint.config.mjs \"./src*/**/*.{mjs,ts,vue,scss,md,json}\"",
    "format": "prettier --write --ignore-unknown \"**/*.{mjs,ts,vue,scss,md,json}\"",
    "precommit": "pretty-quick --staged",
    "prepare": "husky install"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/eslint": "1.17.0",
    "@tanstack/vue-query": "^5.104.5",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@pinia/nuxt": "^1.0.3",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/nuxt": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nuxt-security": "^2.6.0",
    "prettier": "3.9.10",
    "pretty-quick": "^4.2.2",
    "sass-embedded": "^1.106.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "vuetify-nuxt-module": "^0.19.5"
  }
}
